# Clé API Anthropic (https://console.anthropic.com). Sans clé, le jeu tourne en "mode démo" (contenu factice).
ANTHROPIC_API_KEY=

# Modèle utilisé pour simuler les comptes IA
CLAUDE_MODEL=claude-opus-5-5
# Effort pour les actions fréquentes (fil, réponses, DM) : low | medium | high
CLAUDE_EFFORT=low
# Effort pour la création du monde
CLAUDE_EFFORT_WORLD=medium

# Fil automatique : secondes entre deux "ticks" quand l'onglet est ouvert
TICK_SECONDS=90
PORT=3000
